<?xml version="1.0" encoding="utf-8"?>
<!--
  Lumo 的自适应图标（安卓 8.0 及以上）。

  两层：纯色背景 + 角色插画前景。
  前景用的是从插画裁出的 PNG（mipmap-*/ic_launcher_foreground.png），
  不是手画的矢量路径——插画的笔触和渐变靠矢量色块做不出来。

  关于 monochrome：这里故意不提供。
  单色层要求图案能用单一颜色表达（安卓 13 的主题图标会把它染成壁纸配色）。
  插画是彩色位图，转成单色会变成一块灰，不如不提供。不提供时系统退回普通图标，
  这是受支持的降级，不会报错。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
